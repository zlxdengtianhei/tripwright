{
  "permissions": {
    "allow": [
      "mcp__tripwright__*",
      "WebSearch",
      "WebFetch",
      "Agent",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(cd:*)",
      "Bash(date:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(uvx --from ./tools/{{wheel}} tripwright --repo . query:*)"
    ]
  },
  "env": {
    "MCP_TIMEOUT": "60000"
  }
}
