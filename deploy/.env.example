# Copy to deploy/.env (it stays on this computer; never commit it). Every setting of a deployment can live here.
#
# Where the AI apps reach this server, without a path:
#   only a desktop app on this computer: http://localhost:8000
#   phone or web chat apps: the https://… address your tunnel gives (see SETUP.md, Step 1, Docker)
# The host and port in every client's address must match this value exactly (localhost, not 127.0.0.1), or the
# service answers 421.
TRIPWRIGHT_PUBLIC_URL=http://localhost:8000
# Another port on this computer (when 8000 is taken): set it here and use the same port in TRIPWRIGHT_PUBLIC_URL.
# TRIPWRIGHT_PORT=8000
#
# Sign-in with the connector URL <TRIPWRIGHT_PUBLIC_URL>/mcp/<key>. Anyone who has that URL can read and change your
# trips. With this switch the service makes the key at its first start and keeps it in data/remote/url-key (mode 600):
#   cat data/remote/url-key     (Linux: sudo cat, the file belongs to UID 10001)
# Delete that file and restart to get a new key. The switch is not the key; it is safe to share.
TRIPWRIGHT_URL_KEY_GENERATE=1
# Or choose the key yourself (at least 32 letters, digits, '-' or '_'); when set, it wins over the generated one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# TRIPWRIGHT_URL_KEY=
#
# Optional: keep the trips in a Git repository elsewhere (GitHub, GitLab, Gitea: any host with SSH deploy keys).
# It can also be the absolute path of a Git repository inside the container (mount it in, owned by UID 10001, readable
# and writable); a path needs no deploy key.
# Without it they stay in deploy/data as a local Git repository; back that folder up yourself.
# TRIPWRIGHT_REPO_URL=git@github.com:OWNER/PRIVATE_REPO.git   # GitHub goes over port 443 automatically
# TRIPWRIGHT_DEPLOY_KEY="<the whole private key file, each line break written as \n>"
# TRIPWRIGHT_BRANCH=main
#
# The URL key is the only sign-in.
#
# Server with Caddy (compose.yaml): the domain Caddy gets a certificate for.
# TRIPWRIGHT_DOMAIN=trip.example.org
